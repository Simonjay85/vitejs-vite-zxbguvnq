generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  authId    String   @unique // Firebase or Clerk ID
  role      String   @default("PLAYER")
  createdAt DateTime @default(now())

  profile   PlayerProfile?
  rating    RatingProfile?
  auditLogs AuditLog[]
}

model Venue {
  id         String   @id @default(uuid())
  name       String
  location   String
  configJson String?    // SQLite JSON represented as String
  courts     Court[]
  events     Event[]
}

model Court {
  id       String  @id @default(uuid())
  venueId  String
  name     String
  isActive Boolean @default(true)
  venue    Venue   @relation(fields: [venueId], references: [id])
  matches  Match[]
}

model PlayerProfile {
  id        String @id @default(uuid())
  userId    String @unique
  name      String
  gender    String
  bio       String?
  avatarUrl String?
  user      User   @relation(fields: [userId], references: [id])

  matchPlayers  MatchPlayer[]
  queueEntries  QueueEntry[]
}

model RatingProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  skillLevel  String   // e.g., "3.5"
  eloScore    Float    @default(1200.0)
  volatility  Float    @default(50.0) // Glicko-2 style volatility
  lastDecayAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Event {
  id        String       @id @default(uuid())
  venueId   String
  name      String
  mode      String
  startTime DateTime
  endTime   DateTime?
  status    String  @default("SCHEDULED")
  
  venue     Venue        @relation(fields: [venueId], references: [id])
  sessions  EventSession[]
  rules     RuleConfig?
}

model EventSession {
  id       String  @id @default(uuid())
  eventId  String
  metadata String?
  
  event    Event   @relation(fields: [eventId], references: [id])
  queues   QueueEntry[]
  matches  Match[]
  leaderboards LeaderboardSnapshot[]
}

model QueueEntry {
  id            String       @id @default(uuid())
  sessionId     String
  playerId      String       // Simplified for SQLite compatibility
  joinedAt      DateTime     @default(now())
  status        String  @default("WAITING")
  priorityScore Float        @default(0) // Higher score = prioritized for next match
  
  session       EventSession @relation(fields: [sessionId], references: [id])
  player        PlayerProfile @relation(fields: [playerId], references: [id]) 
}

model Match {
  id          String      @id @default(uuid())
  sessionId   String
  courtId     String      @unique
  status      String @default("ONGOING")
  startTime   DateTime    @default(now())
  endTime     DateTime?
  
  session     EventSession @relation(fields: [sessionId], references: [id])
  court       Court        @relation(fields: [courtId], references: [id])
  teams       MatchTeam[]
  scores      ScoreSubmission[]
}

model MatchTeam {
  id        String  @id @default(uuid())
  matchId   String
  teamIndex Int     // 1 or 2
  result    String?
  
  match     Match         @relation(fields: [matchId], references: [id])
  players   MatchPlayer[]
}

model MatchPlayer {
  id               String @id @default(uuid())
  teamId           String
  playerId         String
  performanceDelta Float? // ELO change after match
  
  team             MatchTeam      @relation(fields: [teamId], references: [id])
  player           PlayerProfile  @relation(fields: [playerId], references: [id])
}

model ScoreSubmission {
  id          String   @id @default(uuid())
  matchId     String
  submittedBy String   // User ID
  team1Score  Int
  team2Score  Int
  status      String @default("PENDING")
  
  match       Match    @relation(fields: [matchId], references: [id])
}

model LeaderboardSnapshot {
  id           String   @id @default(uuid())
  sessionId    String
  rankingsJson String     // Frozen state of leaderboard
  createdAt    DateTime @default(now())
  
  session      EventSession @relation(fields: [sessionId], references: [id])
}

model RuleConfig {
  id             String  @id @default(uuid())
  eventId        String  @unique
  maxWaitTimeMin Int     @default(20)
  genderRules    String?   // e.g. {"requireMixed": true}
  pointLimit     Int     @default(11)
  
  event          Event   @relation(fields: [eventId], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  action        String
  targetTable   String
  previousState String?
  newState      String?
  timestamp     DateTime @default(now())
  
  user          User?    @relation(fields: [userId], references: [id])
}
